{
  "name": "soundsteps",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SoundSteps — a free, login-free interactive phonics playground for children.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "audio": "vite-node scripts/audio/generate.ts",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fontsource/andika": "5.1.0",
    "@fontsource/fredoka": "5.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0"
  },
  "devDependencies": {
    "@playwright/test": "1.49.1",
    "@types/node": "20.17.6",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "jsdom": "25.0.1",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vite-node": "2.1.9",
    "vite-plugin-pwa": "0.21.1",
    "vitest": "2.1.9"
  }
}
